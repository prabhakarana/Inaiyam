@model Inaiyam.Models.Post
@{
    ViewData["Title"] = "Post Details";
}
<h2>@Model.Title</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Content</dt>
        <dd class="col-sm-10">@Model.Content</dd>
        <dt class="col-sm-2">Slug</dt>
        <dd class="col-sm-10">@Model.Slug</dd>
        <dt class="col-sm-2">Created</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Updated</dt>
        <dd class="col-sm-10">@Model.UpdatedAt.ToString("yyyy-MM-dd")</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>

